PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://berm_app:change_me@localhost:5432/berm_inventory
DB_POOL_MAX=10

SEED_ADMIN_PASSWORD=change_this_before_seeding
# 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASETO_V3_LOCAL_KEY_BASE64=replace_with_base64_of_32_random_bytes
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
LOG_LEVEL=info
LOG_FORMAT=pretty

# Frontend URL (used for CORS and redirect links)
# For local development: http://localhost:5173
# For production: https://your-vercel-app-url.vercel.app
FRONTEND_URL=http://localhost:5173
