{
  "name": "inventory",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:prod": "npm run db:migrate && npm run db:seed:demo -- --confirm-render && node server.js",
    "dev": "nodemon server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:coverage": "vitest run --no-file-parallelism --coverage",
    "test:integration": "vitest run --no-file-parallelism tests/integration",
    "migrate": "node-pg-migrate -m migrations up",
    "db:migrate": "node-pg-migrate -m migrations up",
    "db:rollback": "node-pg-migrate -m migrations down",
    "db:seed:demo": "node scripts/seed-demo-data.js",
    "deployment:check": "node scripts/deployment-check.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youngoat911/Inventory.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/youngoat911/Inventory/issues"
  },
  "homepage": "https://github.com/youngoat911/Inventory#readme",
  "dependencies": {
    "argon2": "^0.45.1",
    "bcryptjs": "^3.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "paseto": "^4.0.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^1.14.10",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
